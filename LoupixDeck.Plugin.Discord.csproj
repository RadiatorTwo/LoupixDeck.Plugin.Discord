<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>default</LangVersion>
    <DebugType>embedded</DebugType>

    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Translations the host reads off disk from the plugin folder at runtime. -->
    <Content Include="strings.*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Plugin icon, read from the assembly so it does not depend on the install layout. -->
    <EmbeddedResource Include="icon.png" LogicalName="LoupixDeck.Plugin.Discord.icon.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LoupixDeck.PluginSdk" Version="1.28.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <!-- DPAPI for the Windows secret store; only called on Windows. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
  </ItemGroup>

</Project>
